# Copy this file to .env and adjust as needed.

# Port the API server listens on
PORT=4000

# Origin of the Vite dev server (comma-separated list allowed)
CORS_ORIGIN=http://localhost:5173

# Secret used to sign auth tokens — change this in any real deployment
JWT_SECRET=dev-only-change-me

# Token lifetime, in seconds (default 7 days)
TOKEN_TTL_SECONDS=604800

# Set to "true" to enable the /api/auth/dev-login convenience endpoint.
# This exists ONLY because Module 3 (Medicine Management) has no login page
# of its own — auth is a separate module. Turn this OFF once the real
# Auth module is wired up, or in any non-local environment.
ENABLE_DEV_LOGIN=true
